{
  "name": "nexus",
  "private": true,
  "version": "0.1.0",
  "description": "NEXUS — Personal AI Operating System",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:api": "pnpm --filter @nexus/api dev",
    "dev:web": "pnpm --filter @nexus/web dev",
    "build": "pnpm -r --filter=!@nexus/web build && pnpm --filter @nexus/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @nexus/api db:generate",
    "db:migrate": "pnpm --filter @nexus/api db:migrate",
    "db:deploy": "pnpm --filter @nexus/api db:deploy",
    "db:studio": "pnpm --filter @nexus/api db:studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
