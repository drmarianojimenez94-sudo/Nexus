# ==========================================================================
# NEXUS — Environment variables
# Copy to .env and fill in real values. NEVER commit .env with real secrets.
# ==========================================================================

# --- Database (apps/api, database/) ---------------------------------------
# Postgres connection string. Neon is the preferred managed provider.
DATABASE_URL=postgresql://nexus:changeme@localhost:5432/nexus_dev

# --- Auth (apps/api) --------------------------------------------------------
# Long random string used to sign JWT access/refresh tokens.
AUTH_SECRET=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d

# --- API server --------------------------------------------------------------
API_PORT=4000
# Comma-separated list of origins allowed to call the API (web app URL(s)).
API_CORS_ORIGINS=http://localhost:3000

# --- Web app (apps/web) -----------------------------------------------------
# Server-side only (used by next.config.mjs to proxy /api/* — see
# src/lib/api.ts for why the browser never calls this directly).
BACKEND_INTERNAL_URL=http://localhost:4000

# --- AI provider (NexusAIProvider abstraction, apps/api/src/lib/ai.ts) -----
# Optional — Today's insight falls back to a rule-based message with no key.
# Gemini has a limited free tier: https://aistudio.google.com/apikey
# Never expose keys to the frontend. Free-tier prompts may be used to improve Google's products.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional legacy Claude configuration: AI_PROVIDER=anthropic and AI_API_KEY.
AI_API_KEY=
# Leave empty/unset for the provider's default model.

# --- Google connectors (Phase 4, NexusConnector) ---------------------------
# Optional — Settings shows "not configured" instead of a broken button with
# no key. Create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials, enable the Google
# Calendar API for the project, and add the redirect URI below as an
# "Authorized redirect URI" on that client.
# IMPORTANT: this always goes through the web app's /api proxy (same-origin
# cookie reasons, see src/lib/api.ts) — never point it at the API port
# directly. Local dev: http://localhost:3000/api/connectors/google/callback.
# Production: https://<your-deployed-domain>/api/connectors/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connectors/google/callback

# --- Email reminders (apps/api/src/lib/email.ts) ----------------------------
# Optional — see docs/NEXUS_NOTIFICATIONS.md for the full setup (a free
# Resend account + a GitHub Actions cron in this repo, since Render's free
# tier has no cron of its own). Without these, reminders still get created,
# they just never email you.
RESEND_API_KEY=
# Leave blank to use Resend's sandbox sender (onboarding@resend.dev) — works
# with zero setup, no domain verification needed for testing.
RESEND_FROM_EMAIL=
# Any random string — must match the INTERNAL_DISPATCH_SECRET GitHub Actions
# secret exactly. Protects POST /internal/dispatch-reminders, which has no
# per-user login (it's a system endpoint, not a user request).
INTERNAL_DISPATCH_SECRET=
