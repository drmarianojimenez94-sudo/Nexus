# NEXUS mobile — copy to .env and fill in.
# Same deployed NEXUS backend the web app uses — no separate mobile
# server or domain. Points at the public URL; the app calls
# ${EXPO_PUBLIC_API_URL}/api/... same as the web app's own /api/* proxy.
# Local dev against `pnpm dev:api` + `pnpm dev:web`: http://localhost:3000
# Production: https://<your-deployed-nexus-domain>
EXPO_PUBLIC_API_URL=http://localhost:3000
